# Modello delle variabili d'ambiente.
# Copialo in ".env" e cambia i valori. ".env" non va mai su Git.

# Connessione al PostgreSQL di docker-compose.yml.
# 127.0.0.1 e non "localhost": su Windows "localhost" prova prima l'indirizzo IPv6 (::1),
# dove il database non ascolta, e ogni connessione perde circa 2 secondi.
DATABASE_URL="postgresql://gestionale:gestionale@127.0.0.1:5432/gestionale?schema=public"

# Database SEPARATO per i test di integrazione (npm run test:db lo prepara).
# Se manca, i test sul database vengono saltati.
TEST_DATABASE_URL="postgresql://gestionale:gestionale@127.0.0.1:5432/gestionale_test?schema=public"

# Nome dell'azienda mostrato nel programma (titolo, logo, pagina di accesso)
NEXT_PUBLIC_NOME_AZIENDA="Tipografia Rossi"

# Chiave segreta per firmare i cookie di sessione. In produzione è obbligatoria.
# Generala con:  npx auth secret   (oppure: openssl rand -base64 32)
AUTH_SECRET="sostituisci-con-una-stringa-casuale-lunga"

# Primo utente, creato da "npm run db:seed" (facoltativo)
SEED_EMAIL="admin@esempio.it"
SEED_PASSWORD="cambia-questa-password"
SEED_NOME="Amministratore"
